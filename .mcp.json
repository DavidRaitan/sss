{
  "mcpServers": {
    "gutenberg": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/gutenberg-mcp-server@latest"
      ]
    },
    "youtube-transcript": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/jkawamoto/mcp-youtube-transcript",
        "mcp-youtube-transcript"
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    }
  }
}
