# Your key lives here. This file is gitignored -- never commit a real key,
# and never paste one into a chat. If one leaks, revoke it and make a new one.
OPENAI_API_KEY=

# Everything below is optional. The defaults are the best value for money as
# of September 2026; `./run.sh doctor` tells you if one has stopped existing.
#
# CHAVRUTA_MODEL_HEAVY=gpt-5.6-terra     the chavruta's answers
# CHAVRUTA_MODEL_CHEAP=gpt-5.6-luna      sorting what you said (cheap, fast)
# CHAVRUTA_MODEL_STT=gpt-transcribe      hearing you, Hebrew and English together
# CHAVRUTA_MODEL_TTS=gpt-4o-mini-tts     its voice
# CHAVRUTA_VOICE=cedar                   try marin, ash, ballad, coral, sage…
# CHAVRUTA_EFFORT=low                    how hard it thinks: none, low, medium, high.
#                                        Higher is deeper and slower to answer.
#
# To use Claude for thinking instead (hearing and voice then fall back to the
# browser's own, which handles one language at a time):
# CHAVRUTA_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
